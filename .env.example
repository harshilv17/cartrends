# Neon Postgres connection strings.
# DATABASE_URL  — pooled (PgBouncer) URL used by the app at runtime.
# DIRECT_URL    — direct connection used by Prisma for migrations / db push.
#
# Grab both from the Neon dashboard:
#   Project → Connection Details → "Pooled connection" and "Direct connection"
# Append `?sslmode=require` if Neon doesn't already include it.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
